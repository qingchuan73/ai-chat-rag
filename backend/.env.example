DATABASE_URL=mysql+pymysql://user:password@host:3306/ai_chat
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
MODEL_CONFIG_SECRET=change-me-to-a-long-random-string

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Optional fallback model config. Users can also configure their own OpenAI-compatible key in the UI.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Local RAG storage and embedding model.
CHROMA_PATH=./chroma
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh
EMBEDDING_LOCAL_ONLY=true
